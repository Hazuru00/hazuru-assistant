# =============================================================================
# HAZURU'S ASSISTANT — Variables de entorno
# Copia este archivo a .env y rellena los valores reales
# =============================================================================

# -----------------------------------------------------------------------------
# OBLIGATORIAS — El bot NO arranca sin estas
# -----------------------------------------------------------------------------

# Token del bot (Developer Portal → Bot → Reset Token)
# Formato: MTQzNTI2NDk3ODkxNDY0NDA5OA.GUJ0vr.xxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_TOKEN=tu_token_del_bot_aqui

# Application ID (Developer Portal → General Information → Application ID)
# Formato: 1435264978914644098
CLIENT_ID=tu_application_id_aqui

# ID del servidor de desarrollo (Click derecho en servidor → Copy Server ID)
# Usado para registro instantáneo de comandos slash en dev
# Formato: 1527830513270919238
GUILD_ID=tu_guild_id_aqui

# -----------------------------------------------------------------------------
# OPCIONALES
# -----------------------------------------------------------------------------

# Client Secret (Developer Portal → OAuth2 → Client Secret)
# SOLO necesario si implementas login OAuth2 en el dashboard web
# CLIENT_SECRET=tu_client_secret_aqui

# IA con OpenCode (opcional — habilita las consultas por DM/canal con !ai)
# Requiere el servidor de OpenCode corriendo y accesible desde el bot
# ID de Discord del usuario autorizado a usar !ai
OPENCODE_OWNER_ID=tu_discord_user_id_aqui

# URL base de la API de OpenCode
# Default: http://127.0.0.1:4096
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Puerto del servidor web (Dashboard + API + Socket.IO)
# Default: 3001
PORT=3001

# -----------------------------------------------------------------------------
# NOTAS
# -----------------------------------------------------------------------------
# 1. NUNCA commitees .env real — está en .gitignore
# 2. Si filtrás un token: Developer Portal → Bot → Reset Token
# 3. Para producción: usa variables de entorno del proveedor (Railway, Render, VPS, etc.)
# 4. El bot requiere estos Intents habilitados en Developer Portal → Bot:
#    - Server Members Intent (GuildMembers)
#    - Message Content Intent (MessageContent)
#    - Presence Intent (opcional, para status)